# Default deny: only source, documentation and explicit project tooling are candidates.
*
!*/
!.gitignore
!.gitattributes
!.publication-allowlist
!pyproject.toml
!requirements-tested.txt
!README.md
!SECURITY.md
!CONTRIBUTING.md
!src/**/*.py
!tests/**/*.py
!tools/*.py
!docs/*.md
!.githooks/pre-commit
!.githooks/pre-push
!.github/workflows/ci.yml
# Deny these even when nested under an allowed directory.
__pycache__/
*.pyc
.venv/
build/
dist/
*.egg-info/
raw/
data/
inputs/
outputs/
results/
private/
.env*
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.json
*.jsonl
*.ipynb
*.pdf
*.zip
*.gz
*.joblib
*.pkl
*.sqlite*
*.dvc
*.log
*.png
*.jpg
*.tif
*.geojson
*.shp
*.pem
*.key
